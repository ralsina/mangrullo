<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark light">
    <title>Mangrullo - Docker Container Updates</title>
    <link rel="stylesheet" href="/css/pico.min.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chivo:ital,wght@0,100..900;1,100..900&family=Chivo+Mono:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script>
        // Apply the saved theme before first paint (default: dark)
        (function () {
            try {
                var saved = localStorage.getItem('mangrullo-theme');
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch {
                // localStorage unavailable; keep the default dark theme
            }
        }());
    </script>
</head>

<body>
    <nav class="container-fluid">
        <ul>
            <li><a href="/" class="brand-link"><span class="material-icons">cell_tower</span> Mangrullo</a></li>
            <li><small id="autoRefreshStatus">Auto-refresh: ON</small></li>
        </ul>
        <ul>
            <li><button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark/light theme" title="Toggle theme"><span class="material-icons" id="themeToggleIcon">light_mode</span></button></li>
            <li><a href="#" role="button" class="secondary" onclick="checkAllUpdates()">Check for Updates</a></li>
            <li><a href="#" role="button" class="primary" onclick="updateAllContainers()">Update All</a></li>
        </ul>
    </nav>

    <main class="container">
        <div class="header-stats">
            <div class="stat-card">
                <h4>Total Containers</h4>
                <p class="stat-value"><%= total_containers %></p>
            </div>
            <div class="stat-card">
                <h4>Updates Available</h4>
                <p class="stat-value warn"><%= updates_available %></p>
            </div>
        </div>

        <table class="container-table table-striped table-hover" id="containerTable">
            <thead>
                <tr>
                    <th class="sort-none" data-column="0" data-type="string">Container</th>
                    <th class="sort-none" data-column="1" data-type="string">Image</th>
                    <th class="sort-none" data-column="2" data-type="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% containers.sort_by(&.name.lchop('/')).each do |container| %>
                    <%
                      # Get container status from cached state
                      container_state = Mangrullo::ContainerState.instance
                      data = container_state.container(container.id)
                      needs_update = data ? data.update_info.try(&.[:needs_update]) == true : false

                      if container.image.includes?("latest")
                        status_class = "status-latest"
                      elsif needs_update
                        status_class = "status-update-available"
                      else
                        status_class = "status-up-to-date"
                      end

                      # If no data or error, show as error
                      status_class = "status-error" if data.nil?
                    %>
                    <tr class="<%= status_class %>" data-container-id="<%= container.id %>">
                        <td title="<%= container.name.lchop('/') %>"><%= container.name.lchop('/').size > 30 ? container.name.lchop('/')[0..27] + "..." : container.name.lchop('/') %></td>
                        <td title="<%= container.image %>"><code><%= container.image.size > 50 ? container.image[0..47] + "..." : container.image %></code></td>
                        <td>
                            <div class="actions-cell">
                                <% if !needs_update %>
                                <button onclick="checkUpdate('<%= container.id %>')" class="secondary btn-sm">Check</button>
                                <% end %>
                                <% if needs_update %>
                                <button onclick="showUpdateModal('<%= container.id %>')" class="primary btn-sm">Update</button>
                                <% end %>
                            </div>
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>

        <% if containers.empty? %>
            <div class="card">
                <article>
                    <h3>No Running Containers</h3>
                    <p>No Docker containers are currently running. Start some containers to see them here.</p>
                </article>
            </div>
        <% end %>
    </main>

    <footer class="container">
        <hr>
        <p>Mangrullo v<%= Mangrullo::VERSION %> - Docker Container Update Automation</p>
    </footer>

    <!-- Update Modal -->
    <dialog id="updateModal">
        <article>
            <header>
                <h3>Update Container</h3>
                <button aria-label="Close" class="close" onclick="closeModal()"></button>
            </header>
            <p>Are you sure you want to update this container?</p>
            <label>
                <input type="checkbox" id="allowMajor" name="allow_major">
                Allow major version upgrades
            </label>
            <footer>
                <button onclick="confirmUpdate()" class="primary">Update Container</button>
                <button onclick="closeModal()" aria-label="Close" class="secondary">Cancel</button>
            </footer>
        </article>
    </dialog>

    <!-- Bulk Update Modal -->
    <dialog id="bulkUpdateModal">
        <article>
            <header>
                <h3>Update All Containers</h3>
                <button aria-label="Close" class="close" onclick="closeBulkModal()"></button>
            </header>
            <p>Are you sure you want to update all containers that have updates available?</p>
            <label>
                <input type="checkbox" id="bulkAllowMajor" name="allow_major">
                Allow major version upgrades
            </label>
            <label>
                <input type="checkbox" id="dryRun" name="dry_run">
                Dry run (show what would be updated)
            </label>
            <footer>
                <button onclick="confirmBulkUpdate()" class="primary">Update All</button>
                <button onclick="closeBulkModal()" aria-label="Close" class="secondary">Cancel</button>
            </footer>
        </article>
    </dialog>

    <!-- Dry Run Results Modal -->
    <dialog id="dryRunResultsModal">
        <article>
            <header>
                <h3>Dry Run Results</h3>
                <button aria-label="Close" class="close" onclick="closeDryRunResultsModal()"></button>
            </header>
            <div id="dryRunResults">
                <!-- Results will be populated here -->
            </div>
            <footer>
                <button onclick="closeDryRunResultsModal()" class="primary">Close</button>
            </footer>
        </article>
    </dialog>




    <script src="/js/dashboard.js"></script>
</body>
</html>
