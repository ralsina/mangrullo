{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "indent": "off",
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-console": "warn",
    "no-unused-vars": ["error", { "vars": "all", "args": "all", "ignoreRestSiblings": false }],
    "no-undef": "error"
  },
  "globals": {
    "fetch": "readonly",
    "Promise": "readonly",
    "document": "readonly",
    "window": "readonly",
    "console": "readonly",
    "alert": "readonly",
    "currentContainerId": "writable"
  }
}